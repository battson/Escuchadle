rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /* Nadie toca nada que no esté nombrado más abajo. */
    match /{document=**} {
      allow read, write: if false;
    }
    /* ---------- configuración del día ---------- */
    match /escuchadle/dia {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(
                        ['modo','cancion','salto','reinicio','actualizado'])
                   && request.resource.data.modo in ['auto','manual']
                   && request.resource.data.cancion is string
                   && request.resource.data.cancion.size() <= 120
                   && request.resource.data.salto is number
                   && request.resource.data.reinicio is number
                   && request.resource.data.actualizado is number;
    }
    /* ---------- catálogo de canciones ----------
       Un documento con el array entero más el pin del día
       (hoy = {dia, cancion}, opcional). Las reglas no pueden
       recorrer cada elemento de una lista, así que acá se acota el
       tamaño y la forma; el juego sanea el contenido al leerlo. */
    match /escuchadle/catalogo {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(
                        ['canciones','hoy','actualizado'])
                   && request.resource.data.canciones is list
                   && request.resource.data.canciones.size() > 0
                   && request.resource.data.canciones.size() <= 600
                   && request.resource.data.actualizado is number
                   && ( !('hoy' in request.resource.data)
                        || ( request.resource.data.hoy is map
                             && request.resource.data.hoy.keys().hasOnly(['dia','cancion'])
                             && request.resource.data.hoy.dia is number
                             && request.resource.data.hoy.cancion is string
                             && request.resource.data.hoy.cancion.size() <= 200 ) );
    }
    /* ---------- resultados de las partidas ----------
       Se crean y se borran, nunca se modifican. "intentos" en 0
       significa que no la sacó; de 1 a 6, en cuántos la sacó. */
    match /resultados/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
                         ['fecha','nombre','cancion','intentos','marcas'])
                    && request.resource.data.fecha is string
                    && request.resource.data.fecha.size() <= 40
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() <= 40
                    && request.resource.data.cancion is string
                    && request.resource.data.cancion.size() <= 120
                    && request.resource.data.intentos is number
                    && request.resource.data.intentos >= 0
                    && request.resource.data.intentos <= 6
                    && request.resource.data.marcas is list
                    && request.resource.data.marcas.size() <= 6;
      allow update: if false;
      allow delete: if true;
    }
    /* ---------- comentarios y sugerencias ----------
       El nombre vacío se lee como anónimo, así que se permite;
       el mensaje, en cambio, no puede venir vacío. */
    match /sugerencias/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
                         ['fecha','nombre','mensaje'])
                    && request.resource.data.fecha is string
                    && request.resource.data.fecha.size() <= 40
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() <= 40
                    && request.resource.data.mensaje is string
                    && request.resource.data.mensaje.size() > 0
                    && request.resource.data.mensaje.size() <= 600;
      allow update: if false;
      allow delete: if true;
    }
  }
}
